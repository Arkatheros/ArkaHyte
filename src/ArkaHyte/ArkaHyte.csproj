<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<InvariantGlobalization>false</InvariantGlobalization>
		<RootNamespace>ArkaHyte</RootNamespace>
		<!-- Generated by scripts\New-AppIcon.ps1 -->
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<Product>Arka Hyte</Product>
		<AssemblyTitle>Arka Hyte</AssemblyTitle>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
		<None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
	</ItemGroup>

	<!-- The WebView2 package always references its WPF control; this WinForms app does not use it -->
	<Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
		</ItemGroup>
	</Target>

</Project>
