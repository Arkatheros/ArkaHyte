<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<InvariantGlobalization>false</InvariantGlobalization>
		<RootNamespace>ArkaHyte</RootNamespace>
		<!-- Generated by scripts\New-AppIcon.ps1 -->
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<!-- Release version: scripts\New-Release.ps1 passes it on (-p:Version=) and tags the GitHub release -->
		<Version>1.1.0</Version>
		<Product>Arka Hyte</Product>
		<AssemblyTitle>Arka Hyte</AssemblyTitle>
		<!-- The live heap is ~10 MB: no background GC thread needed -->
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<!-- Workstation GC sizes its gen0 budget from the L3 cache (96 MB on a 9800X3D), so the heap
		     kept growing for minutes before a first collection. A hard limit (25x the live heap)
		     scales that budget down; it is the only gen0 control readable from runtimeconfig.json. -->
		<RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="268435456" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
		<None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
		<!-- Installer and updates from GitHub releases; keep in step with the vpk tool in dotnet-tools.json -->
		<PackageReference Include="Velopack" Version="1.2.161" />
	</ItemGroup>

	<!-- The WebView2 package always references its WPF control; this WinForms app does not use it -->
	<Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
		</ItemGroup>
	</Target>

</Project>
